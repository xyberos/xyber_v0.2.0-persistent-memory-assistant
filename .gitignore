# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Type checkers / linters / test caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ---------------------------------------------------------------------------
# Application / local data
# ---------------------------------------------------------------------------

# Local model / vector databases created at runtime (e.g. Xyberos learning.db)
*.db
*.sqlite
*.sqlite3

# Environment variables & secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------

.vscode/
.idea/
*.swp
*.sublime-workspace

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------

.DS_Store
Thumbs.db
