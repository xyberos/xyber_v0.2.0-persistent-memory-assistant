# Xyber configuration template
# Copy this file to `.env` and fill in your real values:
#   cp .env.example .env   (macOS/Linux)
#   copy .env.example .env (Windows)

# --- LLM endpoint (OpenAI-compatible) -------------------------------------
# Remote example (DeepSeek):
XYBEROS_LLM_URL=https://api.deepseek.com
XYBEROS_LLM_API_KEY=sk-your-real-key-here
XYBEROS_LLM_MODEL=deepseek-v4-flash

# Local example (Ollama) - uncomment and adjust:
# XYBEROS_LLM_URL=http://localhost:11434/v1
# XYBEROS_LLM_API_KEY=ollama
# XYBEROS_LLM_MODEL=qwen2.5:1.5b

# --- Optional: commercial web search (switch off the free fallback) -------
# Default (no key): free Google News RSS search — no config needed.
# Set ANY provider key below to switch `web_search` to that commercial
# provider instead (DuckDuckGo scraping was removed as it got bot-blocked):
# TAVILY_API_KEY=tvly-your-key
# SERPER_API_KEY=...
# BRAVE_API_KEY=...
# EXA_API_KEY=...
# FIRECRAWL_API_KEY=...
